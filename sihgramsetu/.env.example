# Copy this to .env.local for local development
# For Vercel deployment, set VITE_API_URL in the Vercel dashboard under Project Settings > Environment Variables

# URL of the deployed Railway backend (no trailing slash, no /api suffix)
# Example: https://gramsetu-backend.up.railway.app/api
VITE_API_URL=https://YOUR_RAILWAY_URL_HERE.up.railway.app/api
